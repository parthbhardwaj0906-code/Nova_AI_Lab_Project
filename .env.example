# ==============================================================================
# Nova Health Configuration (OpenAI-Compatible Providers + Health Settings)
# ==============================================================================
# Set your active provider below by uncommenting the corresponding block.

# ------------------------------------------------------------------------------
# 1. Groq (Recommended: Fast & Free Tier Available at https://console.groq.com)
# ------------------------------------------------------------------------------
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your_groq_api_key_here
MODEL_ID=llama-3.3-70b-versatile

# ------------------------------------------------------------------------------
# 2. Ollama (100% Free & Local, no API key needed - run: ollama run qwen2.5:7b)
# ------------------------------------------------------------------------------
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# MODEL_ID=qwen2.5:7b

# ------------------------------------------------------------------------------
# 3. OpenRouter (Access to 100+ models at https://openrouter.ai)
# ------------------------------------------------------------------------------
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=your_openrouter_api_key_here
# MODEL_ID=qwen/qwen-2.5-72b-instruct

# ------------------------------------------------------------------------------
# Health Safety & Emergency Settings
# ------------------------------------------------------------------------------
# Local emergency dispatch number used for acute red-flag alerts
EMERGENCY_NUMBER=911

# ------------------------------------------------------------------------------
# Voice Narration (Edge-TTS)
# ------------------------------------------------------------------------------
# Free Microsoft Edge neural voice. Examples:
# en-US-AriaNeural (female), en-US-GuyNeural (male), en-GB-SoniaNeural (UK)
TTS_VOICE=en-US-AriaNeural
